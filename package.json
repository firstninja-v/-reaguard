{
  "name": "reaguard",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/firstninja-v/-reaguard.git"
  },
  "private": true,
  "type": "module",
  "description": "Reproducible JavaScript release packaging with bounded synthetic data and integrity verification",
  "bin": {
    "reaguard": "src/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node src/cli.js build examples/calculator.cjs --out release-demo --seed demo --decoys 64",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "engine:build": "cargo build --release --locked --manifest-path engine/Cargo.toml",
    "engine:test": "cargo test --all --locked --manifest-path engine/Cargo.toml",
    "engine:smoke": "node tools/engine-smoke.js",
    "upstream:check": "node tools/check-upstream.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "terser": "5.51.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
